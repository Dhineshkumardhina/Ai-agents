# ==============================================================================
# XEROVA AI DEVFORCE — Environment Configuration Template
# Copy this file to .env before starting the platform:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 2. Database Settings (PostgreSQL 16+ with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devforce
POSTGRES_USER=devforce
POSTGRES_PASSWORD=devforce_dev_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. Security & Cryptography
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Master encryption key for envelope encryption of project secrets (256-bit base64)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
DEVFORCE_MASTER_KEY=your_master_key_base64_placeholder_here

# ------------------------------------------------------------------------------
# 4. Structured Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 5. AI Provider Configuration (Placeholders — configured per workspace/project)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 6. Execution Sandboxing Controls
# ------------------------------------------------------------------------------
DOCKER_SANDBOX_CPU_LIMIT=2.0
DOCKER_SANDBOX_MEMORY_LIMIT=4096m
DOCKER_SANDBOX_PIDS_LIMIT=512

